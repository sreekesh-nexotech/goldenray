# Root env for docker-compose (auto-loaded). Copy to .env and fill in.
# DB creds + the browser-reachable API URLs baked into the frontend at build.

# ── Database (shared Postgres; CMS gets its own DB via initdb/) ────────────────
DB_NAME=GoldenApp
DB_USER=postgres
DB_PASSWORD=change-me
CMS_DB_NAME=blog_cms

# CMS container ALLOWED_HOSTS — add the public host the CMS is served under.
CMS_ALLOWED_HOSTS=localhost,127.0.0.1,cms,flarize.com

# ── Frontend build args (NEXT_PUBLIC_* are inlined into the client bundle at
#    build time, so they MUST be browser-reachable and require a rebuild to
#    change: `docker compose build frontend`) ──────────────────────────────────

# Canonical public origin. Every absolute URL the site emits (canonical tags,
# Open Graph, JSON-LD, sitemap) is built from this. MUST be the non-www host --
# www.flarize.com 301s to it, so a www value here points Google at redirects.
NEXT_PUBLIC_SITE_URL=https://flarize.com

# Main Django backend (solar calculators, leads, etc.)
NEXT_PUBLIC_API_BASE_URL=https://flarize.com/api/

# Blog CMS — Content Studio admin API (authoring)
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://flarize.com/studio-api/admin-api/

# Blog CMS — public delivery API the /blog page reads. Same host as the admin
# API, with /api instead of /admin-api. WITHOUT this the blog shows 0 articles.
NEXT_PUBLIC_BLOG_API_BASE_URL=https://flarize.com/studio-api/api

# ── Instant blog freshness (on-demand revalidation) ───────────────────────────
# Shared secret between the CMS and the frontend. The CMS pings the frontend on
# publish/unpublish/delete so a new article appears on /blog within seconds
# instead of waiting for the hourly ISR window.
#
# This value MUST equal FRONTEND_REVALIDATE_SECRET in
# goldenray-backend/backend/cms/.env, and that file's FRONTEND_REVALIDATE_URL
# must point at the frontend *service* (http://frontend:3000/api/revalidate) —
# not localhost, which inside the CMS container is the CMS itself.
# Unlike the NEXT_PUBLIC_* vars above this is read at runtime, so changing it
# needs only a restart, not a rebuild.
BLOG_REVALIDATE_SECRET=change-me-shared-secret
