# ── Blog CMS environment ──────────────────────────────────────────────────────
# Copy to .env and adjust. Everything has a dev-safe default, so the service runs
# with an empty .env out of the box (SQLite, DEBUG on).
#
# ── Docker / production ───────────────────────────────────────────────────────
# When run via the root docker-compose `cms` service, Compose sets DJANGO_ENV,
# DB_ENGINE, DB_HOST/PORT/NAME/USER/PASSWORD and DJANGO_ALLOWED_HOSTS in the
# container environment. The CMS loads this file with override=False, so those
# compose-provided values WIN and the DB_* lines below are ignored in that mode.
# Everything else here (SECRET_KEY, Bunny, CORS, media/revalidate URLs) still
# comes from this mounted file — set real values before deploying.

DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DB_ENGINE unset (or "sqlite") for a zero-config SQLite dev DB.
# For Postgres (recommended in prod — enables JSONB indexing). Under docker
# these are supplied by Compose (DB_HOST=db); set them here only for a
# non-Docker Postgres run:
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=blog_cms
#   DB_USER=postgres
#   DB_PASSWORD=admin123
#   DB_HOST=localhost
#   DB_PORT=5432
DB_ENGINE=sqlite

# ── Media / public URL ────────────────────────────────────────────────────────
# Absolute base used to build media URLs in the delivery API (so the frontend
# receives fully-qualified image URLs). In prod point this at the CDN/host.
PUBLIC_MEDIA_BASE_URL=http://localhost:8001

# ── CORS: which website origins may call the delivery API ─────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Instant freshness: Next.js on-demand revalidation webhook ─────────────────
# On publish/unpublish/delete the CMS pings this URL so the blog page rebuilds
# in seconds instead of waiting for ISR. Leave blank to disable.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=change-me-shared-secret

# ── BunnyCDN (optional) ───────────────────────────────────────────────────────
# When BUNNY_STORAGE_PASSWORD is set, every uploaded image is compressed
# (WebP, resized to BUNNY_IMAGE_MAX_DIM) and pushed to Bunny storage under
# cms/<collection>/, then served from BUNNY_CDN_BASE_URL. Leave blank to serve
# uploads locally from MEDIA_ROOT instead.
BUNNY_STORAGE_ZONE=golden-ray
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=
BUNNY_PULL_ZONE_ID=
BUNNY_CDN_BASE_URL=https://golden-ray.b-cdn.net
BUNNY_API_KEY=
BUNNY_PURGE_ON_OVERWRITE=true
BUNNY_IMAGE_MAX_DIM=1920
BUNNY_IMAGE_QUALITY=80
